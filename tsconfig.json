{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "node"]
  },
  "include": [
    "apps/**/*.ts",
    "system/server/**/*.ts",
    "database/**/*.ts",
    "tests/**/*.ts",
    "drizzle.config.ts",
