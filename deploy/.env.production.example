# Compose项目名，决定容器和卷前缀；验收使用独立项目名，不能复用生产卷。
COMPOSE_PROJECT_NAME=minmd-prod
# 应用镜像标签；升级使用新标签，避免覆盖旧版本回滚镜像。
MINMD_IMAGE_TAG=local
# 浏览器实际HTTPS来源，不含路径/末尾斜杠。宿主TLS代理需转发至WEB_BIND_PORT。
PUBLIC_ORIGIN=https://docs.example.com
# HTTP监听仅绑定宿主127.0.0.1；整数1–65535，默认8080。
WEB_BIND_PORT=8080
# 内部代理专用IPv4网络及固定web地址，必须同一网段且不与已有Docker/VPN网段冲突。
# app仅信任此web IP；独立验收/恢复项目需改成另一网段和地址。
MINMD_PROXY_SUBNET=172.30.88.0/24
MINMD_PROXY_IP=172.30.88.10
# Docker桥网关/宿主TLS代理进入web的可信地址，必须在上述子网中，不能填写公网网段。
MINMD_PROXY_GATEWAY=172.30.88.1
# 数据库名只用英文字母、数字、下划线。密码使用至少32位随机hex，避免URL特殊字符。
POSTGRES_DB=minmd
POSTGRES_PASSWORD=
# 首次超级管理员初始化；新库必填，密码至少12位。已有账号不会被覆盖。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=
# 登录会话小时1–720，默认24。
AUTH_SESSION_HOURS=24
# 同一文档/表格编辑会话上限，1–100，同账号多页面分别计数，默认10。
DOC_COLLAB_MAX_SESSIONS=10
SHEET_COLLAB_MAX_SESSIONS=10
# 未绑定附件宽限期小时1–720，默认24；历史引用资产保留。
ASSET_UNBOUND_GRACE_HOURS=24
# trace/debug/info/warn/error/fatal/silent，默认info。
LOG_LEVEL=info

# JSON请求体上限字节，1048576–67108864，默认16MiB；multipart另由后端按类型限制，独立文件统一200MiB，文档内图片仍为1MiB。
HTTP_BODY_LIMIT_BYTES=16777216

# AI业务执行时限（不含附件传输），1000–60000毫秒；超时可用相同requestId查询原结果。
AI_EXECUTION_TIMEOUT_MS=15000

# 单文档连接每秒入队消息上限，1–1000，超出会关闭连接。
DOC_COLLAB_MESSAGES_PER_SECOND=100

# 64位十六进制API密钥加密配置，需单独备份并在恢复时保留原值
AI_KEY_ENCRYPTION_KEY=
