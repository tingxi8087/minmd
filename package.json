{
  "name": "minmd",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "system/*",
    "apps/*"
  ],
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "db:sync": "bun run db:generate && bun run db:migrate",
    "build": "bun scripts/build.ts",
    "start": "bun dist/server/main.js",
    "check": "bun run typecheck && bun test && bun run check:web",
    "dev:server": "bun scripts/server-process.ts --watch",
    "dev:web-cms": "bun run --cwd apps/web-cms dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd apps/web typecheck && bun run --cwd apps/web-cms typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:integration": "bun scripts/test-integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun database/migrate.ts",
    "db:reset": "bun scripts/db-reset.ts",
    "dev:web": "bun scripts/web-dev.ts",
    "preview": "bun run --cwd apps/web preview",
    "check:web": "bun run --cwd apps/web check",
    "build:demo": "bun run --cwd apps/web build:demo"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/http-proxy": "^11.6.4",
    "@fastify/multipart": "9",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/websocket": "^11.3.4",
    "@fortune-sheet/core": "1.0.4",
    "@hocuspocus/server": "4.7.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@sinclair/typebox": "^0.34.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@univerjs/core": "1.0.4",
    "drizzle-orm": "^0.45.0",
    "exceljs": "4.4.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "jszip": "3.10.1",
    "pg": "^8.16.0",
    "uuid": "14.0.3",
    "y-prosemirror": "1.3.7",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "yjs": "^13.6.27",
    "zod": "^4.1.0"
  },
  "patchedDependencies": {
    "@fortune-sheet/react@1.0.4": "patches/@fortune-sheet%2Freact@1.0.4.patch"
  }
}
