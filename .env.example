# 运行环境；可选值：development（开发）、staging（预发）、production（正式）。
# 开发环境由后端反代本机 Vite 页面；预发和正式环境使用构建产物。
APP_ENV=development

# 后端监听地址；127.0.0.1 仅允许本机访问，0.0.0.0 监听所有 IPv4 网卡。
HOST=127.0.0.1

# 后端统一访问端口；取值范围：1–65535，与内部两个 Vite 端口不能重复。
PORT=9811

# PostgreSQL 连接地址，格式：postgresql://账号:密码@主机:端口/数据库名。
# 也支持 postgres:// 协议；数据库需预先创建，表结构通过 bun run db:migrate 初始化。
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/minmd_dev

# 日志输出级别；可选值：trace（跟踪）、debug（调试）、info（信息）、warn（警告）、
# error（错误）、fatal（致命错误）、silent（关闭日志输出）；输出所选级别及更严重的日志。
LOG_LEVEL=info

# 仅用于 Vite 开发服务：将浏览器的 /api 请求代理到此后端地址，不是数据库连接。
# 后端 PORT 修改后，需要同步修改这里的端口。
API_PROXY_TARGET=http://127.0.0.1:9811

# 认证凭证传递方式；可选值：bearer（Authorization 请求头）、cookie（HttpOnly Cookie）。
# 每次部署只使用一种方式；修改后需要重启服务并重新登录。
AUTH_TRANSPORT=cookie

# 无域名 HTTP IP 直连；true 开启、false 关闭，默认 false。
# 开启时 PUBLIC_ORIGIN / APP_PUBLIC_ORIGIN 必须为相同的 http://IPv4:端口，
# AUTH_TRANSPORT 必须为 cookie，TRUST_PROXY_ADDRESSES 必须为空。
# 仅在此显式模式关闭 Secure Cookie、HSTS 和 HTTPS 自动升级；HTTP 流量不加密。
HTTP_IP_DIRECT=false

# 仅在 bearer 模式下生效，控制前端令牌存储位置。
# 可选值：memory（内存，刷新页面后丢失）、sessionStorage（当前标签页会话）、
# localStorage（浏览器持久存储）；cookie 模式不使用此配置。
AUTH_TOKEN_STORAGE=sessionStorage

# 登录会话有效期，单位：小时；取值范围：1–720 的整数，默认 24 小时。
AUTH_SESSION_HOURS=24

# 后台页面的浏览器访问来源，主要用于 Cookie 认证的 CSRF 校验，不是跨域白名单。
# 填写协议、主机和端口，不含路径或末尾斜杠；统一开发入口使用 http://127.0.0.1:9811。
# 部署时填写实际访问来源；正式环境使用 cookie 认证时必须为 HTTPS。
PUBLIC_ORIGIN=http://127.0.0.1:9811
# 可信代理IP/CIDR，逗号分隔，默认空（不信任）。仅填实际反向代理地址，且应用端口不得对外开放。
TRUST_PROXY_ADDRESSES=
# HTTP JSON请求体上限，字节；默认16MiB，范围1–64MiB。独立文件上传统一上限200MiB，文档内图片和头像仍为1MiB。
HTTP_BODY_LIMIT_BYTES=16777216
# 每个有效AI密钥每分钟HTTP/MCP请求上限，默认60，范围1–1000；另保留IP级限制。
AI_REQUESTS_PER_MINUTE=60
# AI业务执行截止时间（不含HTTP附件传输），毫秒，默认15000，范围1000–60000；超时写入事务回滚。
AI_EXECUTION_TIMEOUT_MS=15000

# 前台 Cookie 写请求来源，正式环境必须 HTTPS；默认使用 PUBLIC_ORIGIN。
APP_PUBLIC_ORIGIN=http://127.0.0.1:9811
# 仅 development 额外允许的前台来源，逗号分隔；预发和正式忽略此项。
APP_DEV_ORIGINS=
# 公开注册默认关闭，true 开启、false 关闭；默认由后台创建前台账号。
APP_REGISTRATION_ENABLED=false

# 私有附件目录；原文件仅通过鉴权接口读取，不挂载为静态目录。
ASSET_STORAGE_DIR=runtime/assets
# 未绑定附件清理宽限期，小时，1–720，默认24；当前和历史引用均保留。
ASSET_UNBOUND_GRACE_HOURS=24

# 允许跨域访问的来源白名单，多个地址用英文逗号分隔，不含路径，不支持通配符 *。
# 留空表示不允许跨域访问；开发环境通过 Vite 代理请求接口时通常无需配置。
CORS_ORIGINS=

# 运行日志保留天数；取值范围：1–365 的整数，默认 14 天。
LOG_RETENTION_DAYS=14

# 操作审计保留天数；取值范围：1–3650 的整数，默认 365 天。
AUDIT_RETENTION_DAYS=365

# 在线接口调试开关；可选值：true（开启）、false（关闭）。
# 不设置时，开发和预发环境默认开启，正式环境默认关闭；取消下一行注释可显式设置。
# API_DEBUG_ENABLED=false

# 首次启动的超级管理员账号，仅在数据库没有超管时使用；已有超管时忽略，不覆盖账号。
# 长度 3–64 位，以英文字母开头，仅允许英文字母、数字和下划线；自动转为小写。
ADMIN_ACCOUNT=admin

# 首次启动的超级管理员密码，长度 6–128 位；已有超管时忽略，不覆盖密码。
# 仅初始化支持该长度范围，普通账号创建及重置密码仍要求 12–128 位。
ADMIN_PASSWORD=123456

# 后台页面路径，默认 /web-cms；开发反代与预发 / 正式静态托管使用同一路径。
# MinMD 前台占用 /，后台需使用 /admin、/tools/admin 等独立路径，不能占用 /assets 或 /mcp。
# 路径段仅允许英文字母、数字、下划线和连字符；修改后需重启服务，无需重新构建。
# 不可使用 /api 及其子路径，不含域名、查询参数或 Hash；开发环境也使用此路径访问后台。
WEB_CMS_PATH=/admin

# 前台构建产物目录，相对于启动目录；默认 dist/web，仅预发和正式环境托管。
# WEB_DIST=dist/web

# 后台构建产物目录，相对于项目根目录；默认 dist/web-cms，通常无需修改。
# WEB_CMS_DIST=dist/web-cms

# 公开静态文件访问前缀，默认 /public；不能占用 /api 或与后台路径重叠。
STATIC_PATH=/public

# 静态文件目录，相对于项目根目录，也支持绝对路径；启动时自动创建，不存在的文件返回 404。
# 默认 public/ 已被 Git 忽略；更换目录时请自行添加对应忽略规则。
STATIC_DIR=runtime/public

# MinMD 前台和管理后台开发端口，范围 1–65535；被占用时启动失败，不自动换端口。
# 开发网页反代开关，true / false，默认 true；仅 development 生效。
# 只访问后端 PORT；Vite 仅在本机内部提供按需编译，关闭 HMR 后修改页面需刷新。
WEB_DEV_PROXY=true
WEB_PORT=5173
WEB_CMS_PORT=5174

# 仅本机开发的表格协作验证，默认关闭，不能用于正式空间权限。
SHEET_COLLAB_VERIFY_ENABLED=false
# 每份表格同时编辑会话上限；同账号多开分别计数，1–100。
SHEET_COLLAB_MAX_SESSIONS=10
# 旧修订定位窗口（16–4096）。超过窗口的未确认操作需保留恢复副本并重新载入。
SHEET_COLLAB_REVISION_WINDOW=256
# 每个编辑来源最多可撤销的最近操作数（1–4096）；不会撤销其他来源的内容。
SHEET_COLLAB_UNDO_WINDOW=256
# 个人撤销同时受最近全局修订数限制（4096–65536）；过期结构会冻结到检查点，不停止编辑。
SHEET_COLLAB_HISTORY_WINDOW=4096
# 单条协作JSON消息及整个工作簿投影UTF-8字节上限（1024–8388608，默认8MiB）。
SHEET_COLLAB_MAX_MESSAGE_BYTES=8388608
SHEET_COLLAB_MAX_CONTENT_BYTES=8388608
# 每个真实连接每秒到达消息数上限（1–1000）；在排队和数据库事务之前计数。
SHEET_COLLAB_MESSAGES_PER_SECOND=100
# 验证数据保存目录，不属于正式业务存储。
SHEET_COLLAB_VERIFY_DIR=runtime/sheet-verification

# 文档协作仅限本机开发验证，禁止用于正式空间授权
DOC_COLLAB_VERIFY_ENABLED=false
# 每份文档编辑会话上限，整数 1–100，同账号多页面分别计数
DOC_COLLAB_MAX_SESSIONS=10
# 单个文档连接每秒最多接收消息数，包含同步、光标和保存消息；1–1000，默认100。
DOC_COLLAB_MESSAGES_PER_SECOND=100
# Yjs 二进制权威状态目录（已忽略 runtime）
DOC_COLLAB_VERIFY_DIR=runtime/document-verification

# API密钥原文加密密钥：64位十六进制（32字节），未配置时不能创建或查看密钥。需随部署配置备份，勿随意更换。
# 可用 bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))' 生成
AI_KEY_ENCRYPTION_KEY=
