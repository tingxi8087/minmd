# Compose项目名，决定容器和卷前缀；验收使用独立项目名，不能复用生产卷。
COMPOSE_PROJECT_NAME=minmd-prod
# 应用镜像标签；升级使用新标签，避免覆盖旧版本回滚镜像。
MINMD_IMAGE_TAG=local
# 镜像前缀；源码构建默认 minmd，正式部署包由 release.env 给出 GHCR 前缀。
MINMD_IMAGE_PREFIX=minmd
# proxy：已有反代；https：Caddy 自动 HTTPS；direct：IPv4 HTTP 直连。维护命令自动选择对应 Compose。
MINMD_DEPLOY_MODE=proxy
# 浏览器实际来源，不含路径/末尾斜杠；proxy / https 填 HTTPS，direct 填 http://服务器IPv4:9811。
PUBLIC_ORIGIN=https://docs.example.com
# 应用宿主端口；整数1–65535，默认9811。direct 必须与 PUBLIC_ORIGIN 的端口一致。
APP_BIND_PORT=9811
# proxy 默认127.0.0.1；direct 需改为0.0.0.0或可达网卡IPv4，放行防火墙 / 云安全组。
APP_BIND_HOST=127.0.0.1
# 可信代理 IP/CIDR，逗号分隔。安装器自动识别本项目网关或 Caddy 地址，手动部署需填写实际代理地址。
# 网络由 Docker 自动分配；direct 必须留空，不使用代理。不能信任 0.0.0.0/0 或 ::/0。
# HTTP_IP_DIRECT 由 Compose 模式控制：direct=true，其余=false；不是通过此模板自行关闭 HTTPS。
TRUST_PROXY_ADDRESSES=
# 数据库名只用英文字母、数字、下划线。密码使用至少32位随机hex，避免URL特殊字符。
POSTGRES_DB=minmd
POSTGRES_PASSWORD=
# 首次超级管理员初始化；新库必填，密码6–128位，建议至少12位。已有账号不会被覆盖。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=
# 登录会话小时1–720，默认24。
AUTH_SESSION_HOURS=24
# 同一文档/表格编辑会话上限，1–100，同账号多页面分别计数，默认10。
DOC_COLLAB_MAX_SESSIONS=10
SHEET_COLLAB_MAX_SESSIONS=10
# 未绑定附件宽限期小时1–720，默认24；历史引用资产保留。
ASSET_UNBOUND_GRACE_HOURS=24
# trace/debug/info/warn/error/fatal/silent，默认info。
LOG_LEVEL=info

# JSON请求体上限字节，1048576–67108864，默认16MiB；multipart另由后端按类型限制，独立文件统一200MiB，文档内图片仍为1MiB。
HTTP_BODY_LIMIT_BYTES=16777216

# AI业务执行时限（不含附件传输），1000–60000毫秒；超时可用相同requestId查询原结果。
AI_EXECUTION_TIMEOUT_MS=15000

# 单文档连接每秒入队消息上限，1–1000，超出会关闭连接。
DOC_COLLAB_MESSAGES_PER_SECOND=100

# 64位十六进制API密钥加密配置，需单独备份并在恢复时保留原值
AI_KEY_ENCRYPTION_KEY=
