{
  "name": "@mas/web-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/web-cms-dev.ts",
    "start": "vite --mode dev",
    "start:pro": "vite --mode pro",
    "build": "bun --bun vite build --mode pro",
    "build:dev": "vite build --mode dev",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test -c playwright-debug.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.1.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^5.6.0",
    "axios": "^1.4.0",
    "dayjs": "^1.11.21",
    "e-boxes": "^0.0.2",
    "echarts": "^6.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.11.2",
    "remark-gfm": "^4.0.1",
    "vanilla-jsoneditor": "0.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20.3.2",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "jsdom": "^26.1.0",
    "less": "^4.1.3",
    "typescript": "^5.0.2",
    "vite": "^5.3.5",
    "vitest": "^3.2.7"
  }
}
